<?xml version="1.0" encoding="utf-8"?>
<!-- VLC Redesign: the library sidebar (BG/A4) with a Divider/Dim line on top. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rd_dark_divider_dim" />
        </shape>
    </item>
    <item android:top="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/rd_dark_bg_a4" />
        </shape>
    </item>
</layer-list>
