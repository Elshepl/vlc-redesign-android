<?xml version="1.0" encoding="utf-8"?>
<!-- VLC Redesign control bar background (redesign.playerControlBackground #1B1B1B) with the desktop's 1 px separator
     on top (redesign.separator #222222, ControlBar.qml). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/rd_dark_bg_a3" />
        </shape>
    </item>
    <item android:gravity="top" android:height="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/rd_player_separator" />
        </shape>
    </item>
</layer-list>
