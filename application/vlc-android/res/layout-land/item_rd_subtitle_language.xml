<?xml version="1.0" encoding="utf-8"?>
<!-- VLC Redesign: Language row item in landscape dual-pane matching desktop PC -->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:id="@+id/rd_lang_root"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="12dp">

        <!-- Active accent indicator vertical bar on start edge -->
        <View
            android:id="@+id/rd_lang_indicator"
            android:layout_width="3dp"
            android:layout_height="24dp"
            android:background="?attr/colorPrimary"
            android:visibility="gone"
            tools:visibility="visible" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/rd_lang_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/inter_medium"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textColor="@color/rd_dark_fg_1"
                android:textSize="13sp"
                tools:text="Arabic" />

            <TextView
                android:id="@+id/rd_lang_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:textColor="@color/rd_dark_fg_a1"
                android:textSize="11sp"
                android:visibility="gone"
                tools:text="Default · Arabic"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/rd_lang_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:fontFamily="@font/inter"
            android:textColor="@color/rd_dark_fg_a1"
            android:textSize="12sp"
            tools:text="11" />
    </LinearLayout>
</layout>
