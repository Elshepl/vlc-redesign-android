<?xml version="1.0" encoding="utf-8"?>
<!--
  VLC Redesign: the desktop's "Languages and tracks" panel (docs/wiki/Subtitles.md): a dark panel (BG/A3,
  radius 14 on top) with the tabs Video, Audio and Subtitles, opening on Subtitles.
-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="android.view.View" />
    </data>

    <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rd_panel_top">

        <LinearLayout
                android:id="@+id/player_overlay_tracks"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp">

            <com.google.android.material.tabs.TabLayout
                    android:id="@+id/rd_tracks_tabs"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@android:color/transparent"
                    app:tabGravity="fill"
                    app:tabIndicatorColor="?attr/colorPrimary"
                    app:tabIndicatorFullWidth="true"
                    app:tabInlineLabel="true"
                    app:tabMode="fixed"
                    app:tabRippleColor="@color/rd_ripple_dark"
                    app:tabSelectedTextColor="?attr/colorPrimary"
                    app:tabTextAppearance="@style/TextAppearance.Redesign.Tab"
                    app:tabTextColor="@color/rd_dark_fg_a1" />

            <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/rd_dark_divider_dim" />

            <!-- Audio Tab -->
            <include
                    android:id="@+id/audio_tracks"
                    layout="@layout/player_overlay_track_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            <!-- Series preset under audio tracks -->
            <include
                    android:id="@+id/rd_series"
                    layout="@layout/rd_series_preset"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            <!-- Subtitles Tab: Redesigned Subtitle Panel matching PC -->
            <include
                    android:id="@+id/subtitles_panel"
                    layout="@layout/rd_subtitles_panel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

            <!-- Video Tab -->
            <include
                    android:id="@+id/video_tracks"
                    layout="@layout/player_overlay_track_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</layout>
